# Copy this file to .env.local and fill in your key. Never commit .env.local.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: force a specific model. If empty, the app tries
# gemini-3-flash-preview -> gemini-flash-latest -> gemini-2.5-flash
GEMINI_MODEL=

# Optional backups. If Gemini fails or hits its rate limit, the app tries
# Claude, then Groq (only providers with a key are used).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# AI_PROVIDERS=gemini,claude,groq
